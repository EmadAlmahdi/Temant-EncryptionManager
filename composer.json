{
    "name": "temant/encryption-manager",
    "description": "A comprehensive PHP library for encryption and decryption (AES-GCM) with file handling capabilities.",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Temant\\EncryptionManager\\": "Src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Temant\\EncryptionManager\\Tests\\": "Tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.1",
        "mikey179/vfsstream": "^1.6"
    },
    "scripts": {
        "phpstan": "./vendor/bin/phpstan analyse",
        "phpunit": "./vendor/bin/phpunit",
        "check-all": [
            "@phpstan",
            "@phpunit"
        ]
    },
    "scripts-descriptions": {
        "phpstan": "Run PHPStan for static analysis",
        "phpunit": "Run PHPUnit tests"
    },
    "scripts-aliases": {
        "phpstan": [
            "stan",
            "analyze",
            "analyse"
        ],
        "phpunit": [
            "test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
